rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/users/$(request.auth.uid);
    }

    function hasUserDoc(clubId) {
      return signedIn() && exists(userPath(clubId));
    }

    function role(clubId) {
      return hasUserDoc(clubId) ? get(userPath(clubId)).data.role : "";
    }

    function isCoach(clubId) {
      return signedIn() && role(clubId) in ["coach", "admin"];
    }

    function isParent(clubId) {
      return signedIn() && role(clubId) == "parent";
    }

    function approvedFor(clubId, playerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clubs/$(clubId)/parentLinks/$(request.auth.uid + "_" + playerId))
        && get(/databases/$(database)/documents/clubs/$(clubId)/parentLinks/$(request.auth.uid + "_" + playerId)).data.status == "approved";
    }

    function ownUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function parentCreateUserKeys() {
      return request.resource.data.keys().hasOnly(["role", "name", "email", "phone", "consentAcceptedAt", "messageReadAt", "createdAt", "updatedAt"]);
    }

    function parentUpdateUserKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "email", "phone", "consentAcceptedAt", "messageReadAt", "updatedAt"]);
    }

    function playerDevelopmentKeys() {
      return request.resource.data.keys().hasOnly(["playerId", "id", "playerName", "teamId", "level", "band", "foot", "positions", "notes", "reviewedBy", "reviewedByName", "createdAt", "updatedAt"]);
    }

    function playerDocumentKeys() {
      return request.resource.data.keys().hasOnly(["id", "playerId", "playerName", "playerTeamId", "title", "originalFileName", "storagePath", "contentType", "size", "uploadedBy", "uploadedByName", "status", "createdAt", "updatedAt"]);
    }

    function coachDocumentKeys() {
      return request.resource.data.keys().hasOnly(["id", "category", "title", "originalFileName", "storagePath", "contentType", "size", "uploadedBy", "uploadedByName", "status", "createdAt", "updatedAt"]);
    }

    function liftOfferKeys() {
      return request.resource.data.keys().hasOnly(["id", "dateKey", "playerId", "playerName", "playerTeamId", "parentUid", "parentName", "liftSeats", "liftFrom", "status", "createdAt", "updatedAt"]);
    }

    function validParentLiftOffer(clubId, offerId) {
      return signedIn()
        && request.resource.data.id == offerId
        && request.resource.data.parentUid == request.auth.uid
        && approvedFor(clubId, request.resource.data.playerId)
        && request.resource.data.status in ["active", "inactive"]
        && request.resource.data.dateKey is string
        && request.resource.data.playerId is string
        && request.resource.data.playerName is string
        && request.resource.data.parentName is string
        && request.resource.data.liftSeats is number
        && request.resource.data.liftSeats >= 0
        && request.resource.data.liftSeats <= 6
        && request.resource.data.liftFrom is string
        && liftOfferKeys();
    }

    function notificationRequestKeys() {
      return request.resource.data.keys().hasOnly(["id", "audience", "action", "eventId", "teamId", "title", "body", "createdBy", "createdByName", "createdAt", "updatedAt"]);
    }

    match /clubs/{clubId} {
      allow read: if signedIn();
      allow create, update, delete: if isCoach(clubId);

      match /users/{userId} {
        allow read: if isCoach(clubId) || ownUserDoc(userId);
        allow create: if ownUserDoc(userId)
          && request.resource.data.role == "parent"
          && parentCreateUserKeys();
        allow update: if isCoach(clubId)
          || (ownUserDoc(userId)
            && resource.data.role == "parent"
            && request.resource.data.role == "parent"
            && parentUpdateUserKeys());
        allow delete: if isCoach(clubId);
      }

      match /teams/{teamId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /squads/{squadId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /players/{playerId} {
        allow read: if isCoach(clubId) || approvedFor(clubId, playerId);
        allow create, update, delete: if isCoach(clubId);
      }

      match /playerDevelopment/{playerId} {
        allow read: if isCoach(clubId);
        allow create, update: if isCoach(clubId)
          && request.resource.data.playerId == playerId
          && request.resource.data.level in ["Not assessed", "Developmental", "Intermediate", "Advanced"]
          && request.resource.data.band in ["Not set", "Low", "Mid", "High"]
          && request.resource.data.foot in ["Not set", "Right", "Left", "Both"]
          && playerDevelopmentKeys();
        allow delete: if isCoach(clubId);
      }

      match /playerDocuments/{documentId} {
        allow read: if isCoach(clubId) || approvedFor(clubId, resource.data.playerId);
        allow create, update: if isCoach(clubId)
          && request.resource.data.id == documentId
          && request.resource.data.playerId is string
          && request.resource.data.storagePath is string
          && request.resource.data.status in ["active", "archived"]
          && request.resource.data.size is number
          && request.resource.data.size <= 15 * 1024 * 1024
          && request.resource.data.contentType in ["application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ""]
          && playerDocumentKeys();
        allow delete: if isCoach(clubId);
      }

      match /coachDocuments/{documentId} {
        allow read: if isCoach(clubId);
        allow create, update: if isCoach(clubId)
          && request.resource.data.id == documentId
          && request.resource.data.category in ["handbooks", "drills", "coaching-plans"]
          && request.resource.data.storagePath is string
          && request.resource.data.status in ["active", "archived"]
          && request.resource.data.size is number
          && request.resource.data.size <= 15 * 1024 * 1024
          && request.resource.data.contentType in ["application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ""]
          && coachDocumentKeys();
        allow delete: if isCoach(clubId);
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /venues/{venueId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /coachContacts/{coachId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /attendance/{eventId}/players/{playerId} {
        allow read: if isCoach(clubId) || approvedFor(clubId, playerId);
        allow create, update, delete: if isCoach(clubId);
      }

      match /availability/{eventId}/players/{playerId} {
        allow read: if isCoach(clubId) || approvedFor(clubId, playerId);
        allow create, update: if isCoach(clubId)
          || (approvedFor(clubId, playerId)
            && request.resource.data.playerId == playerId
            && request.resource.data.eventId == eventId
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.keys().hasOnly(["playerId", "eventId", "status", "note", "snacks", "liftOffer", "liftSeats", "liftFrom", "updatedBy", "createdAt", "updatedAt"]));
        allow delete: if isCoach(clubId);
      }

      match /liftOffers/{offerId} {
        allow read: if signedIn();
        allow create: if isCoach(clubId) || validParentLiftOffer(clubId, offerId);
        allow update: if isCoach(clubId)
          || (resource.data.parentUid == request.auth.uid && validParentLiftOffer(clubId, offerId));
        allow delete: if isCoach(clubId) || (signedIn() && resource.data.parentUid == request.auth.uid);
      }

      match /parentLinks/{linkId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.parentUid == request.auth.uid);
        allow create, update, delete: if isCoach(clubId);
      }

      match /accessRequests/{requestId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.parentUid == request.auth.uid);
        allow create: if isParent(clubId)
          && request.resource.data.parentUid == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.consent == true
          && request.resource.data.keys().hasOnly(["parentUid", "parentName", "email", "childName", "relation", "status", "consent", "playerId", "playerTeamId", "createdAt", "updatedAt"]);
        allow update, delete: if isCoach(clubId);
      }

      match /dataRequests/{requestId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.parentUid == request.auth.uid);
        allow create: if isParent(clubId)
          && request.resource.data.parentUid == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.requestType in ["delete", "access", "correct", "concern"]
            && request.resource.data.keys().hasOnly(["parentUid", "parentName", "email", "playerId", "playerTeamId", "childName", "requestType", "details", "status", "createdAt", "updatedAt"]);
        allow update, delete: if isCoach(clubId);
      }

      match /coachQueries/{queryId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.parentUid == request.auth.uid);
        allow create: if isParent(clubId)
          && request.resource.data.parentUid == request.auth.uid
          && request.resource.data.status == "open"
          && request.resource.data.keys().hasOnly(["parentUid", "parentName", "email", "subject", "body", "status", "createdAt", "updatedAt"]);
        allow update, delete: if isCoach(clubId);
      }

      match /announcements/{announcementId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /notifications/{notificationId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.userId == request.auth.uid);
        allow create, update, delete: if isCoach(clubId);
      }

      match /notificationRequests/{requestId} {
        allow read: if isCoach(clubId);
        allow create: if isCoach(clubId)
          && request.resource.data.id == requestId
          && request.resource.data.audience == "schedule"
          && request.resource.data.action in ["created", "updated", "deleted"]
          && request.resource.data.teamId in ["all", "team1", "team2"]
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.body is string
          && notificationRequestKeys();
        allow update, delete: if isCoach(clubId);
      }

      match /notificationTokens/{tokenId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.userId == request.auth.uid);
        allow create, update: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly(["token", "platform", "userId", "role", "createdAt", "updatedAt"]);
        allow delete: if isCoach(clubId) || (signedIn() && resource.data.userId == request.auth.uid);
      }
    }
  }
}
