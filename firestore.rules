rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/users/$(request.auth.uid);
    }

    function hasUserDoc(clubId) {
      return signedIn() && exists(userPath(clubId));
    }

    function role(clubId) {
      return hasUserDoc(clubId) ? get(userPath(clubId)).data.role : "";
    }

    function isCoach(clubId) {
      return signedIn() && role(clubId) in ["coach", "admin"];
    }

    function isParent(clubId) {
      return signedIn() && role(clubId) == "parent";
    }

    function approvedFor(clubId, playerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clubs/$(clubId)/parentLinks/$(request.auth.uid + "_" + playerId))
        && get(/databases/$(database)/documents/clubs/$(clubId)/parentLinks/$(request.auth.uid + "_" + playerId)).data.status == "approved";
    }

    function ownUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /clubs/{clubId} {
      allow read: if signedIn();
      allow create, update, delete: if isCoach(clubId);

      match /users/{userId} {
        allow read: if isCoach(clubId) || ownUserDoc(userId);
        allow create: if ownUserDoc(userId)
          && request.resource.data.role == "parent"
          && request.resource.data.keys().hasOnly(["role", "name", "email", "phone", "consentAcceptedAt", "messageReadAt", "canSwitchPortal", "createdAt", "updatedAt"]);
        allow update: if isCoach(clubId)
          || (ownUserDoc(userId)
            && resource.data.role == "parent"
            && request.resource.data.role == "parent"
            && request.resource.data.keys().hasOnly(["role", "name", "email", "phone", "consentAcceptedAt", "messageReadAt", "canSwitchPortal", "createdAt", "updatedAt"]));
        allow delete: if isCoach(clubId);
      }

      match /teams/{teamId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /squads/{squadId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /players/{playerId} {
        allow read: if isCoach(clubId) || approvedFor(clubId, playerId);
        allow create, update, delete: if isCoach(clubId);
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /attendance/{eventId}/players/{playerId} {
        allow read: if isCoach(clubId) || approvedFor(clubId, playerId);
        allow create, update, delete: if isCoach(clubId);
      }

      match /availability/{eventId}/players/{playerId} {
        allow read: if isCoach(clubId) || approvedFor(clubId, playerId);
        allow create, update: if isCoach(clubId)
          || (approvedFor(clubId, playerId)
            && request.resource.data.playerId == playerId
            && request.resource.data.keys().hasOnly(["playerId", "eventId", "status", "note", "snacks", "liftOffer", "liftSeats", "liftFrom", "updatedBy", "createdAt", "updatedAt"]));
        allow delete: if isCoach(clubId);
      }

      match /parentLinks/{linkId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.parentUid == request.auth.uid);
        allow create, update, delete: if isCoach(clubId);
      }

      match /accessRequests/{requestId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.parentUid == request.auth.uid);
        allow create: if isParent(clubId)
          && request.resource.data.parentUid == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.consent == true;
        allow update, delete: if isCoach(clubId);
      }

      match /dataRequests/{requestId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.parentUid == request.auth.uid);
        allow create: if isParent(clubId)
          && request.resource.data.parentUid == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.keys().hasOnly(["parentUid", "parentName", "email", "playerId", "playerTeamId", "childName", "requestType", "details", "status", "createdAt", "updatedAt"]);
        allow update, delete: if isCoach(clubId);
      }

      match /announcements/{announcementId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create, update, delete: if isCoach(clubId);
      }

      match /notifications/{notificationId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.userId == request.auth.uid);
        allow create, update, delete: if isCoach(clubId);
      }

      match /notificationTokens/{tokenId} {
        allow read: if isCoach(clubId) || (signedIn() && resource.data.userId == request.auth.uid);
        allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if isCoach(clubId) || (signedIn() && resource.data.userId == request.auth.uid);
      }
    }
  }
}
